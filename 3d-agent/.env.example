# Mithuna Engine — environment template. Copy to .env (never commit .env).
#
# The client MUST NOT hold secrets. Anything prefixed with VITE_ is embedded in
# the public bundle and visible to every visitor — never put API keys there.

# Paperclip / hermes dev proxy targets (see vite.config.js)
PAPERCLIP_PORT=3100
HERMES_PORT=8765

# Kaalvanta (astrological control plane) — live sidereal chart for the planet
# layer. The Vite dev server proxies /kaalvanta to this port.
KAALVANTA_PORT=8888
# Optional override if you serve Kaalvanta from another origin/path.
# VITE_KAALVANTA_BASE=/kaalvanta

# AR feature — vision/VLM integration (phase 3+) must go through a backend
# route that holds the real key server-side, with rate limiting. Example
# server-side variable names (deliberately NOT VITE_-prefixed):
# VLM_API_KEY=
# VLM_API_URL=https://your-backend.example.com/api/ar/vlm
