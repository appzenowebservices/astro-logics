generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client/binaries"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UtilityType {
  HAIRSTYLE
  MAKEUP
  HOME_DECO
  LINKEDIN
  ASTROLOGY_BIRTH_CHART
  ASTROLOGY_READING
  ASTROLOGY_TRANSIT
  ASTROLOGY_COMPATIBILITY
}

enum GenerationMode {
  PRESETS
  CUSTOM
  MIX_PHOTO // For hairstyle utility
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FileType {
  SOURCE_IMAGE
  RESULT_IMAGE
  REFERENCE_IMAGE
  DOCUMENT
}

enum FileStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  FAILED
}

enum PlanType {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PricingPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
  LIFETIME
  ONE_TIME
}

// ============================================
// ASTROLOGY ENUMS
// ============================================

enum ZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

enum Planet {
  SUN
  MOON
  MERCURY
  VENUS
  MARS
  JUPITER
  SATURN
  URANUS
  NEPTUNE
  PLUTO
  // Lunar Nodes
  NORTH_NODE
  SOUTH_NODE
  // Other points
  ASCENDANT
  MIDHEAVEN
  DESCENDANT
  IC
}

enum House {
  HOUSE_1
  HOUSE_2
  HOUSE_3
  HOUSE_4
  HOUSE_5
  HOUSE_6
  HOUSE_7
  HOUSE_8
  HOUSE_9
  HOUSE_10
  HOUSE_11
  HOUSE_12
}

enum AspectType {
  CONJUNCTION
  SEXTILE
  SQUARE
  TRINE
  OPPOSITION
  QUINCUNX
  SEMISEXTILE
  SEMISQUARE
  SESQUIQUADRATE
  QUINTILE
  BIQUINTILE
}

enum AspectOrb {
  TIGHT // 0-1 degree
  MEDIUM // 1-3 degrees
  WIDE // 3-7 degrees
  VERY_WIDE // 7+ degrees
}

enum PlanetElement {
  FIRE
  EARTH
  AIR
  WATER
}

enum PlanetQuality {
  CARDINAL
  FIXED
  MUTABLE
}

enum ChartType {
  NATAL // Birth chart
  TRANSIT // Current planetary positions
  PROGRESSION // Secondary progression
  SOLAR_RETURN // Solar return chart
  LUNAR_RETURN // Lunar return chart
  COMPOSITE // Relationship composite
  SYNASTRY // Comparison chart
}

enum ReadingType {
  PERSONALITY_PROFILE
  CAREER_GUIDANCE
  RELATIONSHIP_COMPATIBILITY
  LIFE_CHALLENGES
  SPIRITUAL_PATH
  HEALTH_WELLNESS
  FINANCIAL_PROSPERITY
  TIMING_FORECAST
  COMPREHENSIVE_ANALYSIS
}

enum ReadingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CoordinateSystem {
  SIDEREAL
  TROPICAL
}

enum TimeResolution {
  MINUTE
  SECOND
  EVENT_BASED
}

enum PlanetDirection {
  DIRECT
  RETROGRADE
  STATIONARY
}

// ============================================
// MODELS
// ============================================

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  mobile         String?   @unique // Optional for Google OAuth users
  email          String    @unique
  passwordHash   String? // For future password auth
  avatar         String? // Profile picture URL
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  emailVerified  Boolean   @default(false)
  mobileVerified Boolean   @default(false)
  lastLoginAt    DateTime?

  // Usage Statistics
  totalGenerations Int @default(0)
  totalStorageUsed Int @default(0) // Bytes

  // Relations
  accounts Account[]
  sessions Session[]

  // Tenancy / SaaS
  role          Role       @default(MEMBER)
  plan          PlanType   @default(FREE)
  status        UserStatus @default(ACTIVE)
  planExpiresAt DateTime?

  invitesCreated  Invite[]         @relation("InvitesCreated")
  invitesUsed     Invite[]         @relation("InvitesUsed")
  subscriptions   Subscription[]
  posts           Post[]
  tradingAccounts TradingAccount[]

  // Astrology Relations
  nativityCharts NativityChart[]

  // Trading Relations
  marketStateSnapshots MarketStateSnapshot[]
  tradeSignals         TradeSignal[]
  chartDrawings        ChartDrawing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isDeleted])
  @@index([createdAt])
}

// ============================================
// ASTROLOGY MODELS
// ============================================

// ============================================
// NextAuth Models (Required for OAuth)
// ============================================

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String // oauth, credentials, etc.
  provider          String // google, discord, etc.
  providerAccountId String // The provider account ID
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// NATIVITY CHART MODELS
// ============================================================================

model NativityChart {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chart identity
  name        String
  description String?

  // Temporal index (TIME AS FIRST-CLASS INDEX)
  birthDateTime  DateTime
  birthTimestamp BigInt // Unix milliseconds for precise indexing
  timeResolution TimeResolution @default(MINUTE)

  // Coordinate system governance
  coordinateSystem CoordinateSystem @default(SIDEREAL)

  // Location (deterministic state resolution)
  latitude     Float
  longitude    Float
  timezone     String
  locationName String?

  // Ephemeris lattice storage
  ephemerisData EphemerisSnapshot?

  // Geometry-first indexing
  geometryIndex GeometryIndex?

  // Planetary profiles
  planetaryProfiles PlanetaryProfile[]

  // Aspects and relationships
  aspects NativityAspect[]

  // Memory & comparison system
  stateVectors  StateVector[]
  purposeStates PurposeState[]
  similarities  SimilarityRecord[]

  // Current story & Rashoff Theatre
  currentStories CurrentStory[]

  // Consciousness States
  consciousnessStates ConsciousnessState[]

  // Metadata
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, birthTimestamp])
  @@index([coordinateSystem])
  @@index([birthDateTime])
}

model EphemerisSnapshot {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @unique @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  // Indexing metadata
  absoluteTimeIndex BigInt // Milliseconds since epoch
  phase             String? // conjunction cycle, synodic phase

  createdAt DateTime @default(now())
}

model GeometryIndex {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @unique @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  // Configuration vectors
  angularDistances AngularDistance[]

  // Aspect normalization
  aspects NativityAspect[]

  // Clustering metadata
  clusterHash String? // For geometry-based clustering

  createdAt DateTime @default(now())
}

model AngularDistance {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  geometryIndexId String        @db.ObjectId
  geometryIndex   GeometryIndex @relation(fields: [geometryIndexId], references: [id], onDelete: Cascade)

  planet1 String
  planet2 String

  // Angular distance vector
  distance    Float // Degrees
  minDistance Float? // Orb consideration
  maxDistance Float?

  // Speed-weighted similarity
  speedWeighting Float @default(1.0)

  createdAt DateTime @default(now())

  @@unique([geometryIndexId, planet1, planet2])
  @@index([geometryIndexId])
}

model NativityAspect {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  geometryIndexId String        @db.ObjectId
  geometryIndex   GeometryIndex @relation(fields: [geometryIndexId], references: [id], onDelete: Cascade)

  // Aspect definition
  planet1    String
  planet2    String
  aspectType String // conjunction, opposition, square, trine, sextile

  // Exactness & phase
  orbDistance    Float // Degrees from exact
  isApplying     Boolean // Applying vs separating
  exactnessScore Float   @default(0.0) // 0-1

  // Aspect timing
  exactDateTime DateTime?
  buildUpStart  DateTime?
  decayEnd      DateTime?

  // Orb & weighting rules
  orbStrength    Float @default(1.0)
  speedWeighting Float @default(1.0)

  // Planetary profile integration
  planet1ProfileId String?           @db.ObjectId
  planet1Profile   PlanetaryProfile? @relation("aspect_planet1", fields: [planet1ProfileId], references: [id])

  planet2ProfileId String?           @db.ObjectId
  planet2Profile   PlanetaryProfile? @relation("aspect_planet2", fields: [planet2ProfileId], references: [id])

  createdAt DateTime @default(now())

  @@index([nativityChartId, planet1, planet2])
  @@index([aspectType])
  @@index([isApplying])
}

model PlanetaryProfile {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  planet String

  // ============= POSITIONAL DATA (from EphemerisSnapshot) =============
  longitude Float // Sidereal longitude
  latitude  Float? // If applicable

  // Velocity state (SIGNED)
  speed        Float? // Degrees per day (signed: + direct, - retrograde)
  acceleration Float? // Optional but recommended

  // Direction states
  direction           PlanetDirection @default(DIRECT)
  stationaryEnterTime DateTime?
  stationaryExitTime  DateTime?

  // House mapping
  houseCusp            Int? // 1-12
  houseDegree          Float?
  houseSign            String?
  relativeAngularIndex Float? // For planet-planet relationships

  // ============= DOMAIN & DIGNITY DATA =============
  // Domain authority mapping
  primaryDomain   String?
  secondaryDomain String?

  // Incentive model inputs
  dignity           String? // Exalted, Domicile, Detriment, Fall
  strength          Float?
  // Raw scalar cognition vector (stored for quick queries)
  agency            Float?
  stability         Float?
  abstraction       Float?
  emotionality      Float?
  novelty           Float?
  coherence         Float?
  sociality         Float?
  futureOrientation Float?

  // Structured symbolic/state layers
  astroState       Json?
  pressureState    Json?
  behavioralState  Json?
  relationalState  Json?
  situationalState Json?
  narrativeState   Json?
  metaState        Json?

  // Raw ontologies / snapshots
  planetOntology Json?
  signOntology   Json?
  houseOntology  Json?

  // Embeddings / latent representations
  latentVector Json?

  // Derived scalar metrics
  symbolicPressure      Float?
  tensionLevel          Float?
  integrationDifficulty Float?
  manifestationStrength Float?

  // Final synthesized numeric vector/state (JSON map)
  finalState Json?
  // finalState   Json?

  // ============= PLANETARY ENERGY BUDGET =============
  // expressionBandwidth Float? // Finite bandwidth (optional)
  // saturationLevel     Float? @default(0.0) // Over-aspected detection
  // distortionFactor    Float? @default(0.0) // Saturation handling

  // Aspects this planet is involved in
  aspectsAsP1 NativityAspect[] @relation("aspect_planet1")
  aspectsAsP2 NativityAspect[] @relation("aspect_planet2")

  createdAt DateTime @default(now())

  @@index([nativityChartId, planet])
  @@index([direction])
}

model StateVector {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  // Temporal memory (NOT chat memory)
  timestamp      DateTime
  timestampMicro BigInt // Microsecond precision

  // Full state vector
  planetaryStates String @default("[]") @db.String // JSON serialized PlanetData[]
  aspectStates    String @default("[]") @db.String // JSON serialized Aspect[]

  // Attached metadata
  outcomes   String? @db.String // JSON: outcome tags
  decisions  String? @db.String // JSON: decision logs
  narratives String? @db.String // JSON: separate narrative layer

  // Hierarchical memory
  eventLayer     Boolean @default(false)
  patternLayer   Boolean @default(false)
  archetypeLayer Boolean @default(false)

  // Memory hygiene
  confidenceLevel Float @default(1.0)
  entropyScore    Float @default(0.0)

  createdAt DateTime @default(now())

  @@index([nativityChartId, timestamp])
  @@index([timestamp])
}

model PurposeState {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  // Temporal anchor for purpose computation
  timestamp      DateTime
  timestampMicro BigInt // Microsecond precision

  // Source state data (inspired by StateVector)
  planetaryStates String  @default("[]") @db.String // JSON serialized PlanetData[]
  aspectStates    String  @default("[]") @db.String // JSON serialized Aspect[]
  outcomes        String? @db.String // JSON: outcome tags
  decisions       String? @db.String // JSON: decision logs
  narratives      String? @db.String // JSON: narrative context

  // Computation inputs
  intentSignals   String @default("[]") @db.String // JSON: intent / mission signals
  priorityWeights String @default("{}") @db.String // JSON: weighted priorities
  constraintFlags String @default("[]") @db.String // JSON: active constraints

  // Computed vector output
  purposeVector String?   @db.String // JSON serialized purpose vector
  vectorVersion String    @default("v1")
  computedAt    DateTime?

  // Quality metrics
  confidenceLevel Float @default(1.0)
  entropyScore    Float @default(0.0)

  createdAt DateTime @default(now())

  @@index([nativityChartId, timestamp])
  @@index([timestamp])
  @@index([computedAt])
}

model SimilarityRecord {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  // Geometry-based distance function
  similarTo       String // Reference chart ID or timestamp
  similarityScore Float // 0-1, geometric distance

  // Included in similarity
  speedWeighting Boolean @default(true)
  phaseWeighting Boolean @default(true)
  orbWeighting   Boolean @default(true)

  // Query metadata
  queryType String // "past", "future", "similar_pattern"

  createdAt DateTime @default(now())

  @@index([nativityChartId, similarityScore])
}

// ============================================================================
// CURRENT STORY MODELS - Rashoff Theatre
// ============================================================================

model CurrentStory {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String        @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  // Current transit data
  transitDate   DateTime
  userLatitude  Float
  userLongitude Float
  userTimeZone  String?

  // Planetary scenes (one per planet)
  scenes PlanetaryScene[]

  // Current Story State - collective state modified by all planets
  storyState Json // Contains comprehensive behavioral state analysis

  // AI generated plot twist
  mainNarrative    String   @db.String
  overallIntensity Float
  themes           String[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // Re-generate daily

  @@index([nativityChartId])
  @@index([transitDate])
}

model PlanetaryScene {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  currentStoryId String       @db.ObjectId
  currentStory   CurrentStory @relation(fields: [currentStoryId], references: [id], onDelete: Cascade)

  // COMPUTED CORE
  planet           String
  sign             String
  house            Int
  natalLongitude   Float
  currentLongitude Float
  movementDegrees  Float
  intensity        Float

  // PRIMARY DISTILLED PRESSURES
  dominantPressure   String?
  behavioralPattern  String?
  externalConflict   String?
  relationshipEffect String?
  pressureDirection  String?
  collapseRisk       Float?
  momentumDirection  String?
  storyFunction      String?

  // TRANSIT DATA
  activeAspects String[]

  // FULL STRUCTURED STATE
  sceneAttributes Json?

  createdAt DateTime @default(now())

  @@index([currentStoryId])
  @@index([planet])
}

model ConsciousnessState {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  nativityChartId String        @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)

  // Temporal Anchor
  timestamp      DateTime
  timestampMicro BigInt

  // Source references
  ephemerisSnapshotId String? @db.ObjectId
  geometryIndexId     String? @db.ObjectId

  // EXISTENTIAL FIELD
  existentialField Json

  // COGNITIVE FIELD
  cognitiveField Json

  // PLANETARY CONTRIBUTIONS
  planetaryStates Json

  // ASPECT COUPLING STATES
  couplingStates Json

  // META-DYNAMICS
  entropyScore   Float
  coherenceScore Float
  tensionScore   Float
  noveltyScore   Float

  // TEMPORAL MOTION
  trajectoryVector Json?

  // LATENT EMBEDDING
  latentVector Json?

  // VECTOR VERSIONING
  vectorVersion String @default("v1")

  // COMPUTATION METADATA
  simulationSource String?
  confidenceScore  Float   @default(1.0)

  createdAt DateTime @default(now())

  @@index([nativityChartId, timestamp])
  @@index([timestamp])
}

// ============================================
// TRADING / MARKET STATE
// ============================================

model MarketAssetProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  symbol           String   @unique
  label            String?
  category         String?
  exchange         String?
  birthDateTime    DateTime
  birthTimestamp   BigInt
  timezone         String   @default("UTC")
  latitude         Float    @default(51.5074)
  longitude        Float    @default(-0.1278)
  locationName     String   @default("London")
  coordinateSystem String   @default("SIDEREAL")
  isDefault        Boolean  @default(false)
  natalPlanets     Json?

  marketStateSnapshots MarketStateSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketStateSnapshot {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  symbol    String
  timeframe String @default("")
  timestamp Int

  trendState       Json
  volatilityState  Json
  compressionState Json
  liquidityState   Json
  astroState       Json

  embedding Json?

  marketAssetProfileId String?             @db.ObjectId
  marketAssetProfile   MarketAssetProfile? @relation(fields: [marketAssetProfileId], references: [id], onDelete: SetNull)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  events  OperatorEventLog[]
  signals TradeSignal[]

  createdAt DateTime @default(now())

  @@index([symbol, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@index([marketAssetProfileId, timestamp])
}

model OperatorEventLog {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  eventType  String
  strength   Float
  confidence Float
  narrative  String
  metadata   Json?

  snapshotId String              @db.ObjectId
  snapshot   MarketStateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([snapshotId])
  @@index([eventType, createdAt])
}

model TradeSignal {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  marketBias      String
  confidence      Float
  reasoning       String
  suggestedAction String
  riskLevel       String
  keyFactors      Json?
  executed        Boolean @default(false)

  snapshotId String              @db.ObjectId
  snapshot   MarketStateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([snapshotId])
  @@index([marketBias, createdAt])
}

model ChartDrawing {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  symbol      String
  timeframe   String @default("")
  drawingType String // e.g., "trend-line", "fib-retracement", etc.
  drawingId   String // unique id for the drawing on chart
  anchors     Json // JSON array of {time, price} points
  style       Json? // JSON for lineColor, lineWidth, fillColor, etc.
  options     Json? // JSON for tool-specific options

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol, timeframe])
  @@index([userId, symbol])
}

// ============================================
// SAAS: ROLES, INVITES, BILLING, PUBLISHING
// ============================================

enum Role {
  ADMIN
  ANALYST
  MEMBER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum InviteStatus {
  PENDING
  CLAIMED
  REVOKED
  EXPIRED
}

enum PostKind {
  TRADE_IDEA
  ASTRO_READING
}

enum PostVisibility {
  PUBLIC
  MEMBERS
  PREMIUM
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TradingAccountStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

model Invite {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  code        String       @unique
  email       String?
  role        Role         @default(MEMBER)
  plan        PlanType     @default(FREE)
  status      InviteStatus @default(PENDING)
  note        String?
  maxUses     Int          @default(1)
  uses        Int          @default(0)
  expiresAt   DateTime?
  createdById String?      @db.ObjectId
  createdBy   User?        @relation("InvitesCreated", fields: [createdById], references: [id])
  usedById    String?      @db.ObjectId
  usedBy      User?        @relation("InvitesUsed", fields: [usedById], references: [id])
  usedAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([email])
}

model Waitlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  source    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscription {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  userId         String             @db.ObjectId
  user           User               @relation(fields: [userId], references: [id])
  plan           PlanType
  status         SubscriptionStatus @default(ACTIVE)
  period         BillingPeriod      @default(MONTHLY)
  provider       String             @default("razorpay")
  providerSubId  String?
  providerPlanId String?
  currentStart   DateTime           @default(now())
  currentEnd     DateTime?
  cancelAtEnd    Boolean            @default(false)
  amount         Int?
  currency       String             @default("INR")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId, status])
  @@index([providerSubId])
}

model Post {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  slug        String         @unique
  kind        PostKind
  status      PostStatus     @default(DRAFT)
  visibility  PostVisibility @default(MEMBERS)
  title       String
  excerpt     String?
  body        String
  payload     Json?
  symbol      String?
  coverImage  String?
  authorId    String         @db.ObjectId
  author      User           @relation(fields: [authorId], references: [id])
  chartId     String?        @db.ObjectId
  publishedAt DateTime?
  views       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, visibility, publishedAt])
  @@index([kind, status])
  @@index([authorId])
}

model TradingAccount {
  id         String               @id @default(auto()) @map("_id") @db.ObjectId
  userId     String               @db.ObjectId
  user       User                 @relation(fields: [userId], references: [id])
  label      String
  broker     String               @default("MT5")
  login      String
  server     String?
  bridgeUrl  String?
  status     TradingAccountStatus @default(PENDING)
  isDefault  Boolean              @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([userId, login, broker])
  @@index([userId, status])
}
