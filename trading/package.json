{
  "name": "algo-trader-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kaalvanta trading product: MCP algo-trading server + shared market-state analysis engine + Python MT5 bridge. Market data, analysis, and gated order execution.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts",
    "build": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mock": "node scripts/smoke.mjs --mock",
    "bridge": "cd bridge && env\\Scripts\\python.exe -m uvicorn bridge:app --reload",
    "bridge:install": "python -m venv bridge/env && bridge\\env\\Scripts\\python.exe -m pip install -r bridge/requirements.txt"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
