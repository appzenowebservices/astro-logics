    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "dev:web": "next dev --turbo",
    "dev:bridge": "cd trading && npm run bridge",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:bridge\""
